- const CNAME = "webmatesclub.ezequielschwartzman.org"
- const printMode = false

mixin EmojiFavicon(emoji)
  link(
    rel="icon"
    type="image/svg+xml"
    href=`data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${emoji}</text></svg>`
  )
  
mixin Page(name)
    html
      head
        meta(charset="utf-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Share+Tech+Mono&display=swap" rel="stylesheet">
        +EmojiFavicon("💻")
        title Web & Mates Club
        style.
          .bagel-fat-one {
            font-family: "Bagel Fat One", system-ui;
            font-weight: 400;
            font-style: normal;
          }
          .share-tech-mono {
            font-family: "Share Tech Mono", monospace;
            font-weight: 400;
            font-style: normal;
          }
          .grid1 {
            background-size: 1rem 1rem;
            background-image:
              linear-gradient(to right, #fff2 1px, transparent 1px),
              linear-gradient(to bottom, #fff2 1px, transparent 1px);
          }
          .grid2 {
            background-size: 1.5rem 1.5rem;
            background-image:
              linear-gradient(to right, #fff6 1px, transparent 1px),
              linear-gradient(to bottom, #fff6 1px, transparent 1px);
          }
      body[flex flex-col grid1 min-h-screen bg-sky-300 md:(flex flex-row pt24 pb24)]
        block
-
  const colors = [
    'red', 'orange', 'amber', 'yellow', 'lime',
    'green', 'emerald', 'teal', 'cyan', 'sky',
    'blue', 'indigo', 'violet', 'purple', 'fuchsia',
    'pink', 'rose'
  ]

mixin RainbowText(text)
  each letter, i in text
    span(class=`b-b-6 b-${colors[i % colors.length]}-300 underline underline-3  underline-offset-8 text-${colors[i % colors.length]}-500`)= letter
    

+Page("web-club")
  div[flex flex-col justify-center mx-auto py6 md:flex-row md:py0 md:w-screen-sm]
    #container[
