      bg-linear-to-b bg-sky-200 from-white/20 overflow-hidden rounded-2 shadow-[4px_0_10px_#0004]
    ]
      #flier-version[
        absolute right-3 top-3 z-30 px-1
        font-bold font-mono text-3 text-shadow-[0_-1px_0_#0006] text-white
        bg-black/20 rounded-1
      ] Flier v0.1
      #grid-bg[absolute grid2 z-15 h-400% w-400% -rotate-15 -translate-1/2]
      #dashed-border[absolute inset-1 z-20 b-4 b-dashed b-sky-50 rounded-1.5]
      #laptop[flex-cc relative shrink-0 z-20 h-24 my6 w-full]
